# Copy to .env. Demo mode is safe for initial testing.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
MONITOR_MODE=demo
AWS_DEFAULT_REGION=ap-south-1
EC2_INSTANCE_ID=i-your-instance-id
CPU_ALERT_THRESHOLD=80
# Never place AWS access keys in this file. Use aws configure or an IAM role.
